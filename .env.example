# Configuration du site déployé avec Docker. Copier en .env puis : docker compose up -d
# (un changement du .env ne demande pas de reconstruire l'image, juste de recréer le conteneur).

# Images utilisées dans les parties :
#   real = vrais jeux (par défaut) · demo = jeux fictifs générés · mix = les deux
QJ_IMAGES=real

# Jeux du pack « Vrais jeux » à garder (séparés par des virgules). Vide = tous.
# Clés : botw skyrim xcx gtav gtasa gta4 gtavc rdr2 rdr1 er gi aco acor ac4 acu acs fnv cp
QJ_JEUX=
